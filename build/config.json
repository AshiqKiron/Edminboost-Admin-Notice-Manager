{
	"distDir": "dist",
	"zipDir": "dist/zips",
	"corePackage": "packages/core",
	"editions": {
		"free": {
			"overlay": "free",
			"folder": "edminboost-admin-notice-manager",
			"zipNameTemplate": "edminboost-admin-notice-manager-{version}.zip",
			"excludeFromCore": [
				"languages/build-translations.py",
				"languages/google_backend.py",
				"languages/argos_backend.py",
				"languages/apply_generated_json.py",
				"languages/msgids.json",
				"languages/generated"
			]
		},
		"pro": {
			"overlay": "pro",
			"folder": "edminboost-admin-notice-manager-pro",
			"zipNameTemplate": "edminboost-admin-notice-manager-pro-{version}.zip",
			"excludeFromCore": [
				"languages/build-translations.py",
				"languages/google_backend.py",
				"languages/argos_backend.py",
				"languages/apply_generated_json.py",
				"languages/msgids.json",
				"languages/generated"
			]
		}
	}
}

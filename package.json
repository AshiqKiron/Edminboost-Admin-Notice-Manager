{
	"name": "edminboost-admin-notice-manager-monorepo",
	"private": true,
	"description": "Build Free and Pro WordPress plugin zips from packages/core + edition overlays.",
	"scripts": {
		"build": "node build/build.mjs",
		"build:free": "node build/build.mjs --edition=free",
		"build:pro": "node build/build.mjs --edition=pro",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:cli": "wp-env run cli",
		"test:install-php": "bash tests/bin/install-wp-tests.sh",
		"test:php": "phpunit",
		"test:php:unit": "phpunit --testsuite unit",
		"test:php:integration": "phpunit --testsuite integration",
		"test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test -c tests/e2e/playwright.config.ts --ui",
		"test:e2e:report": "playwright show-report test-results/playwright-report",
		"test:qa": "npm run test:php && npm run test:e2e",
		"qa:report": "node scripts/qa-report.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.1",
		"@wordpress/env": "^10.17.0",
		"dotenv": "^16.4.7",
		"typescript": "^5.7.2"
	},
	"engines": {
		"node": ">=18"
	}
}
